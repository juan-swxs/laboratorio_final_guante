# Guante: mismo WiFi y agente micro-ROS que el carro (red de la casa)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_WIFI_SSID="TU_RED_WIFI"
CONFIG_ESP_WIFI_PASSWORD="TU_CLAVE_WIFI"
CONFIG_MICRO_ROS_AGENT_IP="IP_DEL_PC"
CONFIG_MICRO_ROS_AGENT_PORT="8888"
# MPU6050: SDA GPIO21, SCL GPIO22 (fijos en main.c), direccion 0x68/0x69 automatica
# Mismo modulo ESP32 que el carro
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Consola a 921600 para la telemetria CSV a 50 Hz
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
